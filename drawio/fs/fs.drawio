        <mxCell id="jfhTNY-dLuvARTbp_OiM-4" value="struct super_block" style="swimlane;html=1;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeLast=0;collapsible=1;marginBottom=0;swimlaneFillColor=#ffffff;rounded=0;shadow=0;comic=0;labelBackgroundColor=none;strokeWidth=1;fillColor=none;fontFamily=Verdana;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="-450" y="-1360" width="710" height="360" as="geometry" />
        </mxCell>
        <mxCell id="jfhTNY-dLuvARTbp_OiM-5" value="&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; //指向超级块链表的指针,s_list是一个双向循环链表，吧所有的super_block连接起来，一个super_block代表一个在linux上的文件系统&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; struct list_head&amp;nbsp; &amp;nbsp; s_list;&amp;nbsp; &amp;nbsp; &amp;nbsp;/* Keep this first */&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; //包含该具体文件系统的块设备标识符，例如对于/dev/hda1,其设备标识符为0x301&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; dev_t&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;s_dev;&amp;nbsp; &amp;nbsp; &amp;nbsp; /* search index; _not_ kdev_t */&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; unsigned char&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;s_blocksize_bits;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; //blocksize占用的位数&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; unsigned long&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;s_blocksize;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; //文件系统中数据块大小，以字节为单位&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; loff_t&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; s_maxbytes;&amp;nbsp;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;//文件系统中允许的最大文件大小&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; struct file_system_type *s_type;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;//文件系统类型&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; const struct super_operations&amp;nbsp; &amp;nbsp;*s_op;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;//超级块方法,用于超级块操作的函数集合&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; const struct dquot_operations&amp;nbsp; &amp;nbsp;*dq_op;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;//文件系统中用于限额操作的函数集合&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; const struct quotactl_ops&amp;nbsp; &amp;nbsp;*s_qcop;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;//用于配置磁盘限额的方法，处理来自用户空间的请求&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; const struct export_operations *s_export_op;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;//导出方法&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; unsigned long&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;s_flags;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;//安装标识&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; unsigned long&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;s_iflags;&amp;nbsp; &amp;nbsp;/* internal SB_I_* flags */&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; unsigned long&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;s_magic;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;&amp;nbsp;&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;//区别于其他文件系统的标识&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; struct dentry&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;*s_root;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;//指向该具体文件系统安装目录的目录项&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; struct rw_semaphore s_umount;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; int&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;s_count;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;//对超级块的使用计数&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; atomic_t&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; s_active;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(0, 0, 0), rgb(255, 255, 255));&quot;&gt;//引用计数&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;struct block_device *s_bdev;&lt;/span&gt;&lt;span style=&quot;background-color: transparent;&quot;&gt;//指向文件系统被安装的块设备&lt;/span&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="jfhTNY-dLuvARTbp_OiM-4">
          <mxGeometry y="26" width="710" height="334" as="geometry" />
        </mxCell>
        <mxCell id="jfhTNY-dLuvARTbp_OiM-6" value="struct inode" style="swimlane;html=1;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeLast=0;collapsible=1;marginBottom=0;swimlaneFillColor=#ffffff;rounded=0;shadow=0;comic=0;labelBackgroundColor=none;strokeWidth=1;fillColor=none;fontFamily=Verdana;fontSize=12" vertex="1" parent="1">
          <mxGeometry x="340" y="-1360" width="710" height="500" as="geometry" />
        </mxCell>
        <mxCell id="jfhTNY-dLuvARTbp_OiM-7" value="&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; umode_t&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;i_mode;&amp;nbsp; &amp;nbsp; &amp;nbsp;//访问权控制&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; unsigned short&amp;nbsp; &amp;nbsp; &amp;nbsp; i_opflags;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; kuid_t&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; i_uid;&amp;nbsp; //使用者的ID&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; kgid_t&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; i_gid;&amp;nbsp; //用户组ID&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; unsigned int&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; i_flags;&amp;nbsp; &amp;nbsp; //文件系统标志&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; const struct inode_operations&amp;nbsp; &amp;nbsp;*i_op;&amp;nbsp; //索引节点操作表&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; struct super_block&amp;nbsp; *i_sb;&amp;nbsp; //相关的超级块&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; struct address_space&amp;nbsp; &amp;nbsp; *i_mapping; //相关的地址映射&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; unsigned long&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;i_ino;&amp;nbsp; //索引节点号&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; union {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; const unsigned int i_nlink;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; unsigned int __i_nlink; //硬连接数&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; };&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; dev_t&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;i_rdev; //实际设备标识符号&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; loff_t&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; i_size;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; struct timespec64&amp;nbsp; &amp;nbsp;i_atime;&amp;nbsp; &amp;nbsp; //最后访问时间&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; struct timespec64&amp;nbsp; &amp;nbsp;i_mtime;&amp;nbsp; &amp;nbsp; //最后修改时间&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; struct timespec64&amp;nbsp; &amp;nbsp;i_ctime;&amp;nbsp; &amp;nbsp; //最后改变时间&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; spinlock_t&amp;nbsp; &amp;nbsp; &amp;nbsp; i_lock; /* i_blocks, i_bytes, maybe i_size */&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; unsigned short&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; i_bytes;&amp;nbsp; &amp;nbsp; //使用的字节数&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; u8&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; i_blkbits;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; u8&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; i_write_hint;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; blkcnt_t&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; i_blocks;&amp;nbsp; &amp;nbsp;//文件的块数&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;struct hlist_node&amp;nbsp; &amp;nbsp;i_hash; //为了提高查找inode的效率，每一个inode都会有一个hash值&lt;/div&gt;&lt;div&gt;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt;struct list_head&amp;nbsp; &amp;nbsp; i_sb_list;&amp;nbsp; //链接一个文件系统中所有inode的链表&lt;/div&gt;&lt;div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; union {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; struct pipe_inode_info&amp;nbsp; *i_pipe;&amp;nbsp; &amp;nbsp; //管道信息&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; struct block_device *i_bdev;&amp;nbsp; &amp;nbsp; //块设备驱动节点&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; struct cdev&amp;nbsp; &amp;nbsp; &amp;nbsp;*i_cdev;&amp;nbsp; &amp;nbsp; //字符设备驱动节点&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; char&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; *i_link;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; unsigned&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; i_dir_seq;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; };&lt;/div&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="jfhTNY-dLuvARTbp_OiM-6">
          <mxGeometry y="26" width="710" height="464" as="geometry" />
        </mxCell>
        <mxCell id="jfhTNY-dLuvARTbp_OiM-8" value="struct dentry" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=26;fillColor=none;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="-450" y="-910" width="690" height="250" as="geometry" />
        </mxCell>
        <mxCell id="jfhTNY-dLuvARTbp_OiM-9" value="&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; atomic_t d_count;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; /* 引用计数，表示该 dentry 被使用的次数 */&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; unsigned int d_flags;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; /* dentry 状态标志，比如是否在 LRU（Least Recently Used）队列中 */&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; struct inode *d_inode;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;/* 关联的 inode，可能为 NULL（比如符号链接或被删除的文件） */&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; struct qstr d_name;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; /* 目录项的名称（文件/目录名），不包含路径 */&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; struct hlist_bl_node d_hash; /* 哈希表节点，用于 dentry 缓存查找 */&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; struct dentry *d_parent;&amp;nbsp; &amp;nbsp; &amp;nbsp;/* 指向父目录的 dentry */&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; struct list_head d_child;&amp;nbsp; &amp;nbsp; /* 连接到父目录的子目录项列表 */&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; struct list_head d_subdirs;&amp;nbsp; /* 当前目录的子目录列表 */&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; struct super_block *d_sb;&amp;nbsp; &amp;nbsp; /* 指向超级块的指针，表示所属的文件系统 */&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; const struct dentry_operations *d_op;&amp;nbsp; /* dentry 相关操作函数表 */&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; struct rcu_head d_rcu;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;/* 用于 RCU 机制（Read-Copy-Update），异步删除 dentry */&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; struct lockref d_lockref;&amp;nbsp; &amp;nbsp; /* dentry 的锁和引用计数 */&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;&lt;div&gt;&lt;br&gt;&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="jfhTNY-dLuvARTbp_OiM-8">
          <mxGeometry y="26" width="690" height="224" as="geometry" />
        </mxCell>
        <mxCell id="jfhTNY-dLuvARTbp_OiM-10" value="struct file" style="swimlane;fontStyle=0;childLayout=stackLayout;horizontal=1;startSize=26;fillColor=none;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;" vertex="1" parent="1">
          <mxGeometry x="350" y="-830" width="690" height="310" as="geometry" />
        </mxCell>
        <mxCell id="jfhTNY-dLuvARTbp_OiM-11" value="&lt;div&gt;&amp;nbsp; &amp;nbsp; union {&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; struct llist_node fu_llist;&amp;nbsp; &amp;nbsp;/* 用于异步 I/O 处理 */&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; struct rcu_head fu_rcuhead;&amp;nbsp; &amp;nbsp;/* 用于 RCU 释放 */&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; } f_u;&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; struct path f_path;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;/* 该文件的路径信息（dentry 和 vfsmount） */&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; struct inode *f_inode;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; /* 该文件对应的 inode 结构 */&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; const struct file_operations *f_op; /* 文件操作函数指针 */&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; spinlock_t f_lock;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; /* 文件锁，用于同步访问 */&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; atomic_long_t f_count;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; /* 文件引用计数，避免提前释放 */&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; unsigned int f_flags;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;/* 打开文件的标志（O_RDONLY, O_WRONLY 等） */&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; fmode_t f_mode;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;/* 文件访问模式（读/写/执行） */&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; loff_t f_pos;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;/* 当前文件偏移量（用于 `lseek`） */&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; struct fown_struct f_owner;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;/* 信号所有者（异步通知） */&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; const struct cred *f_cred;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; /* 打开该文件的进程的权限凭据 */&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; struct file_ra_state f_ra;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; /* 预读（readahead）状态 */&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; u64 f_version;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; /* 文件版本号（用于缓存一致性） */&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; void *private_data;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp;/* 驱动使用的私有数据（如 `ioctl` 操作） */&lt;/div&gt;&lt;div&gt;&amp;nbsp; &amp;nbsp; struct address_space *f_mapping;&amp;nbsp; /* 文件数据的映射信息 */&lt;/div&gt;" style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;rounded=0;" vertex="1" parent="jfhTNY-dLuvARTbp_OiM-10">
          <mxGeometry y="26" width="690" height="284" as="geometry" />
        </mxCell>
        <mxCell id="jfhTNY-dLuvARTbp_OiM-13" value="超级块/索引节点/目录项/文件数据结构汇总" style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;rounded=0;fontSize=45;" vertex="1" parent="1">
          <mxGeometry x="-70" y="-1590" width="1080" height="80" as="geometry" />
        </mxCell>
        <mxCell id="jfhTNY-dLuvARTbp_OiM-15" value="struct file" style="swimlane;fontStyle=1;align=center;verticalAlign=top;childLayout=stackLayout;horizontal=1;startSize=26;horizontalStack=0;resizeParent=1;resizeParentMax=0;resizeLast=0;collapsible=1;marginBottom=0;whiteSpace=wrap;html=1;fillColor=#e1d5e7;strokeColor=#9673a6;" vertex="1" parent="1">
          <mxGeometry x="-1860" y="-310" width="200" height="130" as="geometry" />
        </mxCell>
        <mxCell id="jfhTNY-dLuvARTbp_OiM-16" value="struct inode &lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;span style=&quot;white-space: pre;&quot;&gt;&#x9;&lt;/span&gt; &lt;/span&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp;*f_inode" style="text;strokeColor=#9673a6;fillColor=#e1d5e7;align=left;verticalAlign=top;spacingLeft=4;spacingRight=4;overflow=hidden;rotatable=0;points=[[0,0.5],[1,0.5]];portConstraint=eastwest;whiteSpace=wrap;html=1;" vertex="1" parent="jfhTNY-dLuvARTbp_OiM-15">
